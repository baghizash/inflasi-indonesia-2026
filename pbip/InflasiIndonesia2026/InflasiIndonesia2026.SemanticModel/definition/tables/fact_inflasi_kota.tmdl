table fact_inflasi_kota
	lineageTag: 6069681a-139d-52fd-b58f-62e018e86563

	measure 'Kota YoY Tertinggi' =
			MAX ( fact_inflasi_kota[yoy_persen] )
		formatString: 0.00
		lineageTag: bca29012-5dff-5f80-a181-13e0af58fa2d

	measure 'Kota YoY Terendah' =
			MIN ( fact_inflasi_kota[yoy_persen] )
		formatString: 0.00
		lineageTag: efe5697f-bf5a-5885-8fa4-d7e409580f13

	measure 'Jumlah Kota Di Atas Nasional' = ```
			VAR Nasional = [Inflasi YoY Terbaru]
			RETURN
			    CALCULATE (
			        COUNTROWS ( fact_inflasi_kota ),
			        fact_inflasi_kota[yoy_persen] > Nasional
			    )
			```
		formatString: 0
		lineageTag: 5ce9db81-d427-53c8-9b22-2e8d82e6d5f4

	column kota_id
		dataType: int64
		formatString: 0
		lineageTag: d40e321c-96f8-552d-8725-b21e5699a00c
		summarizeBy: none
		sourceColumn: kota_id

	column bulan_key
		dataType: int64
		formatString: 0
		lineageTag: b2a13b9a-f5ad-5e26-a932-945ea91e6f3a
		summarizeBy: none
		sourceColumn: bulan_key

	column ihk
		dataType: double
		formatString: 0.00
		lineageTag: 704bf332-af00-5ab0-ba7c-d8716511e88f
		summarizeBy: none
		sourceColumn: ihk

	column yoy_persen
		dataType: double
		formatString: 0.00
		lineageTag: 701bff06-7ae4-5da8-b1c1-d10bf9e75eea
		summarizeBy: none
		sourceColumn: yoy_persen

	column mtm_persen
		dataType: double
		formatString: 0.00
		lineageTag: ff450f14-359d-5c9a-a49e-3a432ec4b1c1
		summarizeBy: none
		sourceColumn: mtm_persen

	partition fact_inflasi_kota = m
		mode: import
		source = ```
				let
					Source = Csv.Document(File.Contents(FolderData & "\fact_inflasi_kota.csv"), [Delimiter = ",", Columns = 5, Encoding = 65001, QuoteStyle = QuoteStyle.None]),
					PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
					ChangedType = Table.TransformColumnTypes(PromotedHeaders, {{"kota_id", Int64.Type}, {"bulan_key", Int64.Type}, {"ihk", type number}, {"yoy_persen", type number}, {"mtm_persen", type number}})
				in
					ChangedType
				```

table fact_inflasi_bulanan
	lineageTag: a7015b7c-a5e2-589f-bfa6-3bf4c5bbd526

	measure 'Inflasi YoY' =
			AVERAGE ( fact_inflasi_bulanan[yoy_persen] )
		formatString: 0.00
		lineageTag: 209b5c12-8568-5cfd-ad08-f5019d751bc7

	measure 'Inflasi MtM' =
			AVERAGE ( fact_inflasi_bulanan[mtm_persen] )
		formatString: 0.00
		lineageTag: 984034e7-a143-5ff8-bb8c-bdfb03ec1754

	measure 'IHK' =
			AVERAGE ( fact_inflasi_bulanan[ihk] )
		formatString: 0.00
		lineageTag: ca4fa7a1-c955-5919-bbe5-748e89ffa1bd

	measure 'Inflasi YoY Terbaru' = ```
			VAR KunciTerbaru =
			    MAX ( fact_inflasi_bulanan[bulan_key] )
			RETURN
			    CALCULATE ( [Inflasi YoY], fact_inflasi_bulanan[bulan_key] = KunciTerbaru )
			```
		formatString: 0.00
		lineageTag: 44347fd4-d075-5fbe-a7a8-ef217688ba85

	measure 'Inflasi MtM Terbaru' = ```
			VAR KunciTerbaru =
			    MAX ( fact_inflasi_bulanan[bulan_key] )
			RETURN
			    CALCULATE ( [Inflasi MtM], fact_inflasi_bulanan[bulan_key] = KunciTerbaru )
			```
		formatString: 0.00
		lineageTag: fa3c8d50-27c9-5005-b7cc-6eb1394472b9

	measure 'IHK Terbaru' = ```
			VAR KunciTerbaru =
			    MAX ( fact_inflasi_bulanan[bulan_key] )
			RETURN
			    CALCULATE ( [IHK], fact_inflasi_bulanan[bulan_key] = KunciTerbaru )
			```
		formatString: 0.00
		lineageTag: 9eb17e85-e16f-5a87-9714-b27dfef96d26

	measure 'Puncak Inflasi YoY' =
			MAX ( fact_inflasi_bulanan[yoy_persen] )
		formatString: 0.00
		lineageTag: e1a3d85f-260e-57bd-9442-df4c4f443c0e

	measure 'Jumlah Bulan Deflasi' =
			CALCULATE ( COUNTROWS ( fact_inflasi_bulanan ), fact_inflasi_bulanan[mtm_persen] < 0 )
		formatString: 0
		lineageTag: bec46a67-77f1-5683-8667-c8ae2ace631e

